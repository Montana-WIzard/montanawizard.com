<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
  <defs>
    <linearGradient id="back-mountains" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#2a3d31" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#1f2d24" stop-opacity="1"/>
    </linearGradient>
    <linearGradient id="front-mountains" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#14201a" stop-opacity="1"/>
      <stop offset="100%" stop-color="#0a1410" stop-opacity="1"/>
    </linearGradient>
  </defs>
  <!-- Back range -->
  <path fill="url(#back-mountains)" d="M0,200 L80,140 L160,180 L240,90 L340,160 L420,110 L520,170 L620,80 L720,150 L820,100 L920,170 L1020,120 L1120,180 L1220,90 L1320,150 L1440,110 L1440,320 L0,320 Z"/>
  <!-- Front range -->
  <path fill="url(#front-mountains)" d="M0,260 L100,200 L180,240 L280,160 L380,220 L480,180 L580,230 L680,170 L780,220 L880,190 L980,240 L1080,180 L1180,230 L1280,170 L1380,220 L1440,200 L1440,320 L0,320 Z"/>
  <!-- Tree silhouettes scattered -->
  <g fill="#0a1410" opacity="0.85">
    <path d="M150,260 l-3,-15 l-4,5 l4,-12 l-4,4 l4,-10 l4,10 l-4,-4 l4,12 l-4,-5 l-3,15 z"/>
    <path d="M340,250 l-3,-15 l-4,5 l4,-12 l-4,4 l4,-10 l4,10 l-4,-4 l4,12 l-4,-5 l-3,15 z" transform="translate(5,0) scale(1.2)"/>
    <path d="M580,255 l-3,-15 l-4,5 l4,-12 l-4,4 l4,-10 l4,10 l-4,-4 l4,12 l-4,-5 l-3,15 z" transform="translate(5,0) scale(0.9)"/>
    <path d="M860,260 l-3,-15 l-4,5 l4,-12 l-4,4 l4,-10 l4,10 l-4,-4 l4,12 l-4,-5 l-3,15 z"/>
    <path d="M1100,255 l-3,-15 l-4,5 l4,-12 l-4,4 l4,-10 l4,10 l-4,-4 l4,12 l-4,-5 l-3,15 z" transform="translate(5,0) scale(1.1)"/>
    <path d="M1280,260 l-3,-15 l-4,5 l4,-12 l-4,4 l4,-10 l4,10 l-4,-4 l4,12 l-4,-5 l-3,15 z"/>
  </g>
</svg>
